# Datacendia — Apache .htaccess for Namecheap Shared Hosting
# Replaces netlify.toml functionality

# ============================================================================
# Custom 404 Page
# ============================================================================
ErrorDocument 404 /404.html

# ============================================================================
# Security Headers
# ============================================================================
<IfModule mod_headers.c>
    # Force HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy
    #
    # 'unsafe-inline' is required by the site as it stands today. Do NOT remove it
    # without doing the refactor described below first -- taking it out breaks the
    # whole site, silently and badly:
    #
    #   script-src 'unsafe-inline'  33 executable inline <script> blocks across 33 files,
    #                               plus 220 inline on*= handlers. demos/council.html keeps
    #                               its entire engine in a 38KB inline script, so a strict
    #                               script-src leaves AGENTS/renderAgents undefined and every
    #                               interactive demo renders nothing at all.
    #   style-src  'unsafe-inline'  4,591 inline style= attributes across 247 of 560 HTML
    #                               files, plus 150 embedded <style> blocks. Nonces cannot
    #                               help here: static files on LiteSpeed cannot mint a
    #                               per-request nonce, and nonces never apply to style=
    #                               attributes or on*= handlers in any case.
    #
    # To harden this properly: extract the 33 inline scripts to external .js files and
    # convert the 220 on*= handlers to addEventListener, then drop 'unsafe-inline' from
    # script-src only. style-src 'unsafe-inline' has to stay until the 4,591 style
    # attributes are refactored, which is a much lower-value change.
    #
    # plausible.io needs BOTH script-src (to load script.js) and connect-src (it POSTs
    # events to /api/event) -- script-src alone fails silently.
    #
    # analytics.tiktok.com is deliberately NOT allowed. tiktok-pixel.js still ships with
    # PIXEL_ID = 'YOUR_TIKTOK_PIXEL_ID' and self-disables, so it does nothing today; enabling
    # it means turning on third-party tracking, which needs a consent/privacy review first.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://plausible.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io mailto:"

    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

    # XSS Protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ============================================================================
# MIME Types
# ============================================================================
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg .svgz
    AddType application/json .json
    AddType application/xml .xml
    AddType text/xml .xsl
    AddType video/mp4 .mp4
    AddType application/pdf .pdf
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ============================================================================
# Compression (if mod_deflate available)
# ============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml application/xml image/svg+xml
</IfModule>

# ============================================================================
# Browser Caching
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ============================================================================
# Clean URLs — serve .html files without extension
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request doesn't have an extension and a matching .html file exists, serve it
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ============================================================================
# Force HTTPS
# ============================================================================
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
